# Server Port
PORT=3000

# Neon PostgreSQL Connection String (Dapatkan dari dashboard Neon)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-darkness-123456.ap-southeast-1.aws.neon.tech/jobdb?sslmode=require"

# Allowed CORS Origin (pisahkan dengan koma jika lebih dari satu, atau gunakan * untuk semua origin)
# Contoh: http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173"